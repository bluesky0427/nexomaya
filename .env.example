# =============================================================================
# Nexomaya Technology Group — Environment Variables (EXAMPLE)
# -----------------------------------------------------------------------------
# Copy this file to `.env.local` for local development:
#     cp .env.example .env.local
#
# On Vercel, add these same keys under:
#     Project → Settings → Environment Variables
#
# IMPORTANT: Never commit real API keys. `.env.local` and `.env` are gitignored.
# =============================================================================

# -----------------------------------------------------------------------------
# Resend — transactional email service (https://resend.com)
# -----------------------------------------------------------------------------
# 1. Create a free account at https://resend.com
# 2. Verify your sending domain (nexomaya.com) in the Resend dashboard and add
#    the DNS records it shows in GoDaddy (MX + TXT on "send", a TXT DKIM record
#    on "resend._domainkey"). See README §8.
# 3. Create an API key (API Keys → Create) and paste it below.
RESEND_API_KEY=re_your_api_key_here

# -----------------------------------------------------------------------------
# Email addresses used by the contact form API route
# -----------------------------------------------------------------------------
# Where the internal notification (a new contact submission) is delivered.
# This inbox must actually receive mail (see README §8b). Until a mailbox for
# nexomaya.com exists, use an address you already have.
CONTACT_TO_EMAIL=support@nexomaya.com

# The "from" address for the internal notification email.
# Must be on a domain you have verified in Resend.
CONTACT_FROM_EMAIL=no-reply@nexomaya.com

# The "from" address for the automatic thank-you email sent to the visitor.
CONTACT_THANK_YOU_FROM_EMAIL=no-reply@nexomaya.com

# -----------------------------------------------------------------------------
# Public site URL — used for canonical URLs, sitemap, and SEO metadata.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://www.nexomaya.com

# -----------------------------------------------------------------------------
# Cloudflare Turnstile — bot protection for the contact form (optional)
# -----------------------------------------------------------------------------
# Free at https://dash.cloudflare.com → Turnstile → Add widget (add nexomaya.com
# and localhost as hostnames). Set BOTH keys, or neither: with only the secret
# set, every submission is rejected. Leave both empty to disable the check.
#
# Cloudflare test keys for local development (always pass):
#   NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
#   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
